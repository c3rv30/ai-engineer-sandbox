# Base de datos
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/postgres

# Firma del contexto de tenant (obligatoria: ni la API ni la base de datos arrancan
# sin ella). La usan los dos lados: la aplicación firma el tenant y las políticas RLS
# verifican la firma, de modo que una inyección SQL no pueda cambiar de tenant.
# Genera una clave con: openssl rand -hex 32
TENANT_SIGNING_KEY=

# Autenticación JWT (obligatoria: la API no arranca sin ella)
# Genera una clave con: openssl rand -hex 32
JWT_SECRET_KEY=

# OpenAI
OPENAI_API_KEY=tu_clave_de_openai_aqui

# Langfuse
LANGFUSE_SECRET_KEY=tu_secret_key_de_langfuse
LANGFUSE_PUBLIC_KEY=tu_public_key_de_langfuse
LANGFUSE_HOST=https://cloud.langfuse.com

# Caché del modelo de re-ranking (opcional)
# Por defecto ~/.cache/flashrank. NO usar /tmp: es volátil y su pérdida
# deja la API sin arrancar. En Docker, apuntar a una ruta de la imagen.
# RERANKER_CACHE_DIR=/opt/models/flashrank
