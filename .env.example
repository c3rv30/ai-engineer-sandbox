# Configuration template. Copy it to .env and fill in the required entries
# BEFORE starting the database: docker compose reads TENANT_SIGNING_KEY from .env
# and refuses to start without it.

# --- Database ---
# Always app_user, never postgres. A superuser bypasses the RLS policies with or
# without FORCE ROW LEVEL SECURITY: with it, every tenant would see everyone's data (DOC-03).
# The role and its password are created by sql/00_create_app_user.sql.
DATABASE_URL=postgresql://app_user:apppassword@localhost:5433/postgres

# --- Anthropic (required) ---
# Used by the supervisor, the generator, memory, the evaluator, GraphRAG and image
# ingestion. Without it the API starts, but every question fails with a 500 error.
ANTHROPIC_API_KEY=

# --- Tenant context signature (required) ---
# Neither the API nor the database starts without it. Both sides use it: the application
# signs the tenant and the RLS policies verify the signature, so that an SQL injection
# cannot switch tenants (SEC-05).
# Generate a key with: openssl rand -hex 32
TENANT_SIGNING_KEY=

# --- JWT authentication (required) ---
# The API does not start without it (SEC-01).
# Generate a key with: openssl rand -hex 32
JWT_SECRET_KEY=

# --- Langfuse (optional) ---
# Without keys, tracing is disabled and the application works the same.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Re-ranking model cache (optional) ---
# ~/.cache/flashrank by default. Do NOT use /tmp: it is volatile and losing it
# leaves the API unable to start. In Docker, point it at a path inside the image.
# RERANKER_CACHE_DIR=/opt/models/flashrank
