# Plantilla de configuración. Cópiala a .env y rellena las entradas obligatorias
# ANTES de levantar la base de datos: docker compose lee TENANT_SIGNING_KEY de .env
# y se niega a arrancar sin ella.

# --- Base de datos ---
# Siempre app_user, nunca postgres. Un superusuario se salta las políticas RLS con o
# sin FORCE ROW LEVEL SECURITY: con él, cada tenant vería los datos de todos (DOC-03).
# El rol y su contraseña los crea sql/00_create_app_user.sql.
DATABASE_URL=postgresql://app_user:apppassword@localhost:5433/postgres

# --- Anthropic (obligatoria) ---
# La usan el supervisor, el redactor, la memoria, el evaluador, GraphRAG y la ingesta
# de imágenes. Sin ella la API arranca, pero cada pregunta falla con un error 500.
ANTHROPIC_API_KEY=

# --- Firma del contexto de tenant (obligatoria) ---
# Ni la API ni la base de datos arrancan sin ella. La usan los dos lados: la aplicación
# firma el tenant y las políticas RLS verifican la firma, de modo que una inyección SQL
# no pueda cambiar de tenant (SEC-05).
# Genera una clave con: openssl rand -hex 32
TENANT_SIGNING_KEY=

# --- Autenticación JWT (obligatoria) ---
# La API no arranca sin ella (SEC-01).
# Genera una clave con: openssl rand -hex 32
JWT_SECRET_KEY=

# --- Langfuse (opcional) ---
# Sin claves, el tracing queda desactivado y la aplicación funciona igual.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Caché del modelo de re-ranking (opcional) ---
# Por defecto ~/.cache/flashrank. NO usar /tmp: es volátil y su pérdida
# deja la API sin arrancar. En Docker, apuntar a una ruta de la imagen.
# RERANKER_CACHE_DIR=/opt/models/flashrank
